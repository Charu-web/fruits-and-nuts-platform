// ==============================================================================
// PRISMA SCHEMA SPECIFICATION — M/S FRUITS & NUTS PLATFORM
// ==============================================================================
// Authoritative Phase 8 Relational Schema Implementation
// Target Engine: PostgreSQL 16+
// ==============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==============================================================================
// 1. IDENTITY & ACCESS CONTROL DOMAIN
// ==============================================================================

enum RoleType {
  SUPER_ADMIN
  INVENTORY_MGR
  ORDER_MGR
  CONTENT_MGR
  CUSTOMER
}

model Role {
  id          String   @id // 'SUPER_ADMIN', 'INVENTORY_MGR', 'ORDER_MGR', 'CONTENT_MGR', 'CUSTOMER'
  name        String   @db.VarChar(64)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  users       User[]

  @@map("roles")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  roleId           String    @map("role_id") @db.VarChar(32)
  phone            String?   @unique @db.VarChar(20)
  email            String?   @unique @db.VarChar(255)
  passwordHash     String?   @map("password_hash") @db.VarChar(255)
  isActive         Boolean   @default(true) @map("is_active")
  isPhoneVerified  Boolean   @default(false) @map("is_phone_verified")
  isEmailVerified  Boolean   @default(false) @map("is_email_verified")
  twoFactorSecret  String?   @map("two_factor_secret") @db.VarChar(128)
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  role                  Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  profile               Profile?
  addresses             Address[]
  orders                Order[]
  reviews               Review[]
  wishlists             Wishlist[]
  carts                 Cart[]
  couponUsages          CouponUsage[]
  auditLogs             AuditLog[]
  inventoryTransactions InventoryTransaction[]
  orderStatusHistories  OrderStatusHistory[]

  @@map("users")
}

model Profile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  firstName        String?  @map("first_name") @db.VarChar(64)
  lastName         String?  @map("last_name") @db.VarChar(64)
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  avatarUrl        String?  @map("avatar_url") @db.Text
  marketingConsent Boolean  @default(false) @map("marketing_consent")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum AddressType {
  HOME
  WORK
  OTHER
}

model Address {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  recipientName     String      @map("recipient_name") @db.VarChar(128)
  phone             String      @db.VarChar(20)
  addressLine1      String      @map("address_line1") @db.VarChar(255)
  addressLine2      String?     @map("address_line2") @db.VarChar(255)
  landmark          String?     @db.VarChar(128)
  city              String      @db.VarChar(64)
  state             String      @db.VarChar(64)
  postalCode        String      @map("postal_code") @db.VarChar(10)
  country           String      @default("India") @db.VarChar(64)
  addressType       AddressType @default(HOME) @map("address_type")
  isDefaultShipping Boolean     @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean     @default(false) @map("is_default_billing")
  gstin             String?     @db.VarChar(15)
  companyName       String?     @map("company_name") @db.VarChar(128)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefaultShipping])
  @@map("addresses")
}

// ==============================================================================
// 2. PRODUCT CATALOGUE DOMAIN
// ==============================================================================

model Category {
  id              Int           @id @default(autoincrement())
  name            String        @db.VarChar(128)
  slug            String        @unique @db.VarChar(128)
  description     String?       @db.Text
  imageUrl        String?       @map("image_url") @db.Text
  displayOrder    Int           @default(0) @map("display_order")
  isActive        Boolean       @default(true) @map("is_active")
  metaTitle       String?       @map("meta_title") @db.VarChar(128)
  metaDescription String?       @map("meta_description") @db.VarChar(255)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  subcategories Subcategory[]
  products      Product[]

  @@index([isActive, displayOrder])
  @@map("categories")
}

model Subcategory {
  id           Int       @id @default(autoincrement())
  categoryId   Int       @map("category_id")
  name         String    @db.VarChar(128)
  slug         String    @unique @db.VarChar(128)
  description  String?   @db.Text
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products Product[]

  @@index([categoryId, isActive])
  @@map("subcategories")
}

enum HealthContentStatus {
  DRAFT_REVIEW
  APPROVED
  REJECTED
}

model Product {
  id                  String              @id @default(uuid()) @db.Uuid
  categoryId          Int                 @map("category_id")
  subcategoryId       Int?                @map("subcategory_id")
  name                String              @db.VarChar(255)
  slug                String              @unique @db.VarChar(255)
  skuBase             String              @unique @map("sku_base") @db.VarChar(64)
  description         String              @db.Text
  ingredients         String?             @db.Text
  allergenInfo        String?             @map("allergen_info") @db.Text
  nutritionFacts      Json?               @map("nutrition_facts") // {"energy_kcal": 579, "protein_g": 21.2, ...}
  storageInstructions String?             @map("storage_instructions") @db.Text
  shelfLifeMonths     Int?                @map("shelf_life_months")
  hsnCode             String?             @map("hsn_code") @db.VarChar(16)
  gstPercentage       Decimal             @default(5.00) @map("gst_percentage") @db.Decimal(4, 2)
  isActive            Boolean             @default(true) @map("is_active")
  isFeatured          Boolean             @default(false) @map("is_featured")
  isByobEligible      Boolean             @default(false) @map("is_byob_eligible")
  healthContentStatus HealthContentStatus @default(DRAFT_REVIEW) @map("health_content_status")
  metaTitle           String?             @map("meta_title") @db.VarChar(128)
  metaDescription     String?             @map("meta_description") @db.VarChar(255)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category             Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory          Subcategory?         @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  variants             ProductVariant[]
  images               ProductImage[]
  reviews              Review[]
  orderItems           OrderItem[]
  tasteMapAssociations TasteMapAssociation[]

  @@index([categoryId, subcategoryId, isActive])
  @@index([slug])
  @@map("products")
}

enum WeightUnit {
  GRAMS
  KILOGRAMS
  LITRES
  PIECES
}

model ProductVariant {
  id               String     @id @default(uuid()) @db.Uuid
  productId        String     @map("product_id") @db.Uuid
  sku              String     @unique @db.VarChar(64)
  weightGrams      Decimal    @map("weight_grams") @db.Decimal(8, 2)
  unit             WeightUnit @default(GRAMS)
  packageType      String     @default("STAND_UP_POUCH") @map("package_type") @db.VarChar(64)
  mrp              Decimal    @db.Decimal(12, 2)
  sellingPrice     Decimal    @map("selling_price") @db.Decimal(12, 2)
  wholesalePrice   Decimal?   @map("wholesale_price") @db.Decimal(12, 2)
  wholesaleMinQty  Int?       @default(5) @map("wholesale_min_qty")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory             Inventory?
  inventoryTransactions InventoryTransaction[]
  cartItems             CartItem[]
  wishlists             Wishlist[]
  orderItems            OrderItem[]

  @@unique([productId, weightGrams, packageType], name: "uq_product_weight_pkg")
  @@index([productId, sellingPrice])
  @@index([sku])
  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  storageKey String   @map("storage_key") @db.Text
  imageUrl   String   @map("image_url") @db.Text
  altText    String   @map("alt_text") @db.VarChar(255)
  sortOrder  Int      @default(0) @map("sort_order")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// ==============================================================================
// 3. INVENTORY & STOCK LEDGER DOMAIN
// ==============================================================================

model Inventory {
  variantId             String   @id @map("variant_id") @db.Uuid
  stockAvailable        Int      @default(0) @map("stock_available")
  stockReserved         Int      @default(0) @map("stock_reserved")
  safetyBufferThreshold Int      @default(10) @map("safety_buffer_threshold")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

enum InventoryTransactionType {
  RESTOCK
  ORDER_HOLD
  ORDER_DEDUCT
  CANCEL_RESTORE
  AUDIT_ADJUST
}

model InventoryTransaction {
  id              String                   @id @default(uuid()) @db.Uuid
  variantId       String                   @map("variant_id") @db.Uuid
  transactionType InventoryTransactionType @map("transaction_type")
  quantityDelta   Int                      @map("quantity_delta")
  stockAfter      Int                      @map("stock_after")
  referenceType   String?                  @map("reference_type") @db.VarChar(32)
  referenceId     String?                  @map("reference_id") @db.VarChar(64)
  actorId         String?                  @map("actor_id") @db.Uuid
  notes           String?                  @db.Text
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@map("inventory_transactions")
}

// ==============================================================================
// 4. COMMERCE & TRANSACTIONS DOMAIN
// ==============================================================================

model Cart {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String?  @map("user_id") @db.Uuid
  guestSessionToken  String?  @unique @map("guest_session_token") @db.VarChar(128)
  couponCode         String?  @map("coupon_code") @db.VarChar(32)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId], name: "uq_cart_variant")
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId], name: "uq_user_wishlist_variant")
  @@map("wishlists")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id                    String        @id @default(uuid()) @db.Uuid
  orderNumber           String        @unique @map("order_number") @db.VarChar(32)
  userId                String?       @map("user_id") @db.Uuid
  customerName          String        @map("customer_name") @db.VarChar(128)
  customerEmail         String        @map("customer_email") @db.VarChar(255)
  customerPhone         String        @map("customer_phone") @db.VarChar(20)

  // Immutable Shipping Address Snapshot
  shippingRecipientName String        @map("shipping_recipient_name") @db.VarChar(128)
  shippingAddressLine1  String        @map("shipping_address_line1") @db.VarChar(255)
  shippingAddressLine2  String?       @map("shipping_address_line2") @db.VarChar(255)
  shippingCity          String        @map("shipping_city") @db.VarChar(64)
  shippingState         String        @map("shipping_state") @db.VarChar(64)
  shippingPostalCode    String        @map("shipping_postal_code") @db.VarChar(10)
  shippingPhone         String        @map("shipping_phone") @db.VarChar(20)

  // Financial Snapshot
  subtotalAmount        Decimal       @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount        Decimal       @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  shippingFee           Decimal       @default(0.00) @map("shipping_fee") @db.Decimal(12, 2)
  giftWrapFee           Decimal       @default(0.00) @map("gift_wrap_fee") @db.Decimal(12, 2)
  taxAmount             Decimal       @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  finalPayableAmount    Decimal       @map("final_payable_amount") @db.Decimal(12, 2)
  currency              String        @default("INR") @db.VarChar(3)

  giftMessage           String?       @map("gift_message") @db.Text
  giftWrapEnabled       Boolean       @default(false) @map("gift_wrap_enabled")

  orderStatus           OrderStatus   @default(PENDING) @map("order_status")
  paymentStatus         PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod         String        @map("payment_method") @db.VarChar(32)

  gstin                 String?       @db.VarChar(15)
  companyName           String?       @map("company_name") @db.VarChar(128)

  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  refunds       Refund[]
  shipments     Shipment[]
  statusHistory OrderStatusHistory[]
  couponUsages  CouponUsage[]

  @@index([userId, createdAt])
  @@index([orderStatus])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String?  @map("product_id") @db.Uuid
  variantId           String?  @map("variant_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(255)
  skuSnapshot         String   @map("sku_snapshot") @db.VarChar(64)
  weightGramsSnapshot Decimal  @map("weight_grams_snapshot") @db.Decimal(8, 2)
  unitPriceSnapshot   Decimal  @map("unit_price_snapshot") @db.Decimal(12, 2)
  quantity            Int
  lineTotalSnapshot   Decimal  @map("line_total_snapshot") @db.Decimal(12, 2)
  hsnCodeSnapshot     String?  @map("hsn_code_snapshot") @db.VarChar(16)
  gstRateSnapshot     Decimal  @map("gst_rate_snapshot") @db.Decimal(4, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reviews Review[]

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  previousStatus String?  @map("previous_status") @db.VarChar(32)
  newStatus      String   @map("new_status") @db.VarChar(32)
  changedByUserId String? @map("changed_by_user_id") @db.Uuid
  reason         String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ==============================================================================
// 5. PAYMENTS, REFUNDS & LOGISTICS DOMAIN
// ==============================================================================

model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  provider          String   @db.VarChar(64) // 'RAZORPAY', 'CASHFREE', 'PHONEPE', 'COD'
  providerOrderId   String?  @map("provider_order_id") @db.VarChar(128)
  providerPaymentId String?  @unique @map("provider_payment_id") @db.VarChar(128)
  providerSignature String?  @map("provider_signature") @db.VarChar(255)
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("INR") @db.VarChar(3)
  paymentMethod     String   @map("payment_method") @db.VarChar(32)
  status            String   @db.VarChar(32) // 'INITIATED', 'PENDING', 'SUCCESS', 'FAILED', 'REFUNDED'
  rawResponse       Json?    @map("raw_response")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@index([providerPaymentId])
  @@map("payments")
}

model Refund {
  id                 String    @id @default(uuid()) @db.Uuid
  orderId            String    @map("order_id") @db.Uuid
  paymentId          String    @map("payment_id") @db.Uuid
  amount             Decimal   @db.Decimal(12, 2)
  reason             String    @db.Text
  providerRefundId   String?   @unique @map("provider_refund_id") @db.VarChar(128)
  status             String    @default("PENDING") @db.VarChar(32)
  initiatedByUserId  String?   @map("initiated_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt        DateTime? @map("completed_at") @db.Timestamptz

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@map("refunds")
}

model WebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String   @db.VarChar(64)
  eventId     String   @unique @map("event_id") @db.VarChar(128)
  eventType   String   @map("event_type") @db.VarChar(64)
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@map("webhook_events")
}

model Shipment {
  id                    String    @id @default(uuid()) @db.Uuid
  orderId               String    @map("order_id") @db.Uuid
  provider              String    @db.VarChar(64) // 'SHIPROCKET', 'DELHIVERY', 'BLUEDART'
  shipmentReferenceId   String?   @map("shipment_reference_id") @db.VarChar(128)
  awbNumber             String?   @unique @map("awb_number") @db.VarChar(128)
  courierName           String?   @map("courier_name") @db.VarChar(128)
  shippingLabelUrl      String?   @map("shipping_label_url") @db.Text
  manifestId            String?   @map("manifest_id") @db.VarChar(128)
  status                String    @default("MANIFESTED") @db.VarChar(32)
  estimatedDeliveryDate DateTime? @map("estimated_delivery_date") @db.Date
  actualDeliveryDate    DateTime? @map("actual_delivery_date") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([awbNumber])
  @@map("shipments")
}

// ==============================================================================
// 6. MARKETING, REVIEWS & DISCOVERY DOMAIN
// ==============================================================================

enum DiscountType {
  PERCENTAGE
  FLAT_AMOUNT
}

model Coupon {
  id                String       @id @default(uuid()) @db.Uuid
  code              String       @unique @db.VarChar(32)
  discountType      DiscountType @map("discount_type")
  discountValue     Decimal      @map("discount_value") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?     @map("max_discount_amount") @db.Decimal(12, 2)
  minOrderAmount    Decimal      @default(0.00) @map("min_order_amount") @db.Decimal(12, 2)
  usageLimitTotal   Int?         @map("usage_limit_total")
  usageLimitPerUser Int          @default(1) @map("usage_limit_per_user")
  startDate         DateTime     @map("start_date") @db.Timestamptz
  endDate           DateTime     @map("end_date") @db.Timestamptz
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz

  usages CouponUsage[]

  @@index([code, isActive, endDate])
  @@map("coupons")
}

model CouponUsage {
  id              String   @id @default(uuid()) @db.Uuid
  couponId        String   @map("coupon_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  discountApplied Decimal  @map("discount_applied") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, couponId], name: "uq_order_coupon")
  @@map("coupon_usage")
}

enum ModerationStatus {
  PENDING_MODERATION
  APPROVED
  REJECTED
}

model Review {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  productId        String           @map("product_id") @db.Uuid
  orderItemId      String?          @map("order_item_id") @db.Uuid
  rating           Int
  title            String?          @db.VarChar(128)
  reviewText       String           @map("review_text") @db.Text
  photos           Json?            // Array of S3 URLs
  isVerifiedBuyer  Boolean          @default(true) @map("is_verified_buyer")
  moderationStatus ModerationStatus @default(PENDING_MODERATION) @map("moderation_status")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([productId, moderationStatus])
  @@map("reviews")
}

model TasteMapRegion {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(128)
  slug               String   @unique @db.VarChar(128)
  state              String   @db.VarChar(64)
  pinCoordinates     Json     @map("pin_coordinates") // {"lat": 34.08, "lng": 74.79, "x_pct": 34.2, "y_pct": 18.5}
  culturalStory      String   @map("cultural_story") @db.Text
  verificationSource String?  @map("verification_source") @db.Text
  bannerImageUrl     String?  @map("banner_image_url") @db.Text
  displayOrder       Int      @default(0) @map("display_order")
  isPublished        Boolean  @default(false) @map("is_published")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  associations TasteMapAssociation[]

  @@map("taste_map_regions")
}

model TasteMapAssociation {
  id        Int      @id @default(autoincrement())
  regionId  Int      @map("region_id")
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  region  TasteMapRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([regionId, productId], name: "uq_region_product")
  @@map("taste_map_associations")
}

enum StoreStatus {
  OPEN
  COMING_SOON
  TEMPORARILY_CLOSED
}

model StoreLocation {
  id             Int         @id @default(autoincrement())
  name           String      @db.VarChar(128)
  addressStreet  String      @map("address_street") @db.VarChar(255)
  city           String      @db.VarChar(64)
  state          String      @db.VarChar(64)
  postalCode     String      @map("postal_code") @db.VarChar(10)
  phone          String      @db.VarChar(20)
  email          String?     @db.VarChar(128)
  latitude       Decimal?    @db.Decimal(10, 7)
  longitude      Decimal?    @db.Decimal(10, 7)
  googleMapsUrl  String?     @map("google_maps_url") @db.Text
  operatingHours Json?       @map("operating_hours") // {"mon_sat": "10:00 AM - 9:30 PM", ...}
  outletStatus   StoreStatus @default(OPEN) @map("outlet_status")
  displayOrder   Int         @default(0) @map("display_order")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("store_locations")
}

// ==============================================================================
// 7. CMS & GOVERNANCE DOMAIN
// ==============================================================================

model CMSSection {
  id           String   @id @default(uuid()) @db.Uuid
  sectionKey   String   @unique @map("section_key") @db.VarChar(64) // 'HOMEPAGE_HERO', 'ANNOUNCEMENT_BAR', etc.
  title        String?  @db.VarChar(128)
  contentJson  Json     @map("content_json")
  isPublished  Boolean  @default(true) @map("is_published")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("cms_sections")
}

model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(64)
  channel       String    @db.VarChar(32) // 'SMS', 'WHATSAPP', 'EMAIL'
  recipient     String    @db.VarChar(255)
  payloadJson   Json      @map("payload_json")
  status        String    @default("QUEUED") @db.VarChar(32) // 'QUEUED', 'SENT', 'FAILED'
  failureReason String?   @map("failure_reason") @db.Text
  sentAt        DateTime? @map("sent_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(64)
  entityName String   @map("entity_name") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.VarChar(64)
  prevState  Json?    @map("prev_state")
  newState   Json?    @map("new_state")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityName, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
